# Домен кабинета (для профиля https — Caddy выпустит сертификат сам)
DOMAIN=reg.example.com
# Белый IP сервера: его Asterisk сообщает SIP-провайдеру
PUBLIC_IP=203.0.113.10

# Пароль базы и общий токен API ↔ воркер ↔ Asterisk (длинные случайные строки):
#   openssl rand -hex 24
POSTGRES_PASSWORD=
INTERNAL_TOKEN=
# Подпись сессий кабинета; пусто — выводится из INTERNAL_TOKEN
JWT_SECRET=

# Первый вход в кабинет (потом пароль меняется в Настройках)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Порты: SIP (tcp) и RTP (udp) должны быть открыты наружу
SIP_PORT=5060
RTP_PORTS=10000-10100

# Кабинет на хосте, если HTTPS делает свой nginx (без профиля https)
APP_BIND=127.0.0.1
APP_PORT=3000
