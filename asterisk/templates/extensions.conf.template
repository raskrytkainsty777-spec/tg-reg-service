[incoming-sip]
exten => s,1,NoOp(Incoming SIP call)
 same => n,Set(CALL_UUID=\${UUID()})
 same => n,Set(CALLER=\${CALLERID(num)})
 same => n,Set(TO_HEADER=\${PJSIP_HEADER(read,To)})
 same => n,Set(TO_URI=\${CUT(TO_HEADER,@,1)})
 same => n,Set(DID=\${CUT(TO_URI,:,2)})
 same => n,Goto(check)
 same => n(check),Set(CHECK_RESPONSE=\${CURL(${BACKEND_INTERNAL_URL}/internal/asterisk/check-call?caller=\${CALLER}&did=\${DID}&uuid=\${CALL_UUID}&token=${INTERNAL_TOKEN:-})})
 same => n,GotoIf(\$[\"\${CHECK_RESPONSE}\" = \"ok\"]?accept:reject)
 same => n(reject),Hangup()
 same => n(accept),Answer()
 same => n,AudioSocket(\${CALL_UUID},${AUDIO_SOCKET_HOST}:${AUDIO_SOCKET_PORT})
 same => n,Hangup()

